# CDC 是常驻流进程，非 Lambda handler：用官方 slim 底座（glibc 新，无 wheel 兼容问题）
FROM python:3.11-slim

WORKDIR /app

# 先拷依赖清单（层缓存：改代码不触发重装依赖）
COPY ./pyproject.toml ./uv.lock ./

# pip 装 uv（清华源），从锁文件导出依赖装进系统 site-packages，装完清理清单
RUN pip install --no-cache-dir uv -i https://pypi.tuna.tsinghua.edu.cn/simple && \
    uv export --frozen --no-dev --no-emit-project --no-hashes -o requirements.txt && \
    pip install --no-cache-dir -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple && \
    rm requirements.txt pyproject.toml uv.lock

# 裸导入支持：core 在 /app 下；data_cdc 内的 config 靠脚本目录自动进路径
COPY ./src/data_cdc ./data_cdc
COPY ./src/core ./core
ENV PYTHONPATH=/app

# 常驻 change stream 循环；异常退出时由 compose restart: always 拉起
CMD ["python", "/app/data_cdc/cdc.py"]